# Proveedor del modelo: openai (por defecto) o anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales
# LLM_MODEL=gpt-5-mini          # por defecto: gpt-5-mini (openai) / claude-opus-5-5 (anthropic)
# LLM_EFFORT=medium             # esfuerzo de razonamiento: low | medium | high
